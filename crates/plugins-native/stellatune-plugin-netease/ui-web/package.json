    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.1",
    "esbuild": "^0.25.0",
    "@types/node": "^22.0.0"
  }
}
