{
  "manifest_version": 2,
  "id": "dev.stellatune.source.ncm",
  "name": "NCM Local Files",
  "version": "0.2.0",
  "runtime": {
    "kind": "typescript",
    "entry": "plugin.mjs",
    "api_version": 2,
    "protocol": "stellatune-capability-rpc/1"
  },
  "capabilities": [
    {
      "id": "ncm-file",
      "kind": "source-resolver",
      "execution_class": "control",
      "display_name": "NCM local file source",
      "local_extensions": [
        "ncm"
      ]
    }
  ]
}
