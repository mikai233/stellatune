{
  "manifest_version": 2,
  "id": "dev.stellatune.output.asio",
  "name": "ASIO Output",
  "version": "0.2.3",
  "runtime": {
    "kind": "typescript",
    "entry": "plugin.mjs",
    "api_version": 2,
    "protocol": "stellatune-capability-rpc/1"
  },
  "capabilities": [{
    "id": "asio",
    "kind": "output-sink",
    "execution_class": "control",
    "display_name": "ASIO",
    "config_schema": "schema/output.json",
    "native_output": {
      "protocol": "asio-v10",
      "executable": "bin/stellatune-asio-host.exe"
    }
  }]
}
